# 复制为 .env：cp .env.example .env
# docker compose 会自动读取本文件

# ── 必填 ────────────────────────────────────────────────────────────────
# 课堂派登录 token
# 获取：浏览器登录 https://w.ketangpai.com → F12 → Console → 执行
#   copy(localStorage.getItem('token') || localStorage.getItem('token_for_login'))
KTP_TOKEN=

# ── 建议设置 ────────────────────────────────────────────────────────────
# 看板访问令牌（留空 = 不校验）。公网暴露时必须设置，访问时带 ?token=xxx
DASHBOARD_TOKEN=

# ── 可选 ────────────────────────────────────────────────────────────────
# 巡检间隔（秒）
POLL_INTERVAL=10

# 课程列表刷新间隔（秒）：新加入的课程最迟这么久后纳入巡检
COURSE_REFRESH_SEC=300

# 每日汇总事件的整点（0 = 关闭）
DAILY_REPORT_HOUR=21

# 并发扫描的课程数：课程多时调高能缩短单轮耗时，别超过 8
POOL_SIZE=4

# 宿主机监听地址与端口（容器内部固定 8080）
# 只绑 127.0.0.1 最安全；公网访问请用反向代理 + HTTPS
BIND_ADDR=127.0.0.1
BIND_PORT=18080
